#!/usr/bin/env python3
"""Public deterministic Knowmade CLI.

The upstream-compatible deterministic implementation is kept as an internal
compatibility module while new control-plane surfaces are split into bounded
modules. ``legacy_cli`` imports the shared root, Markdown, and schema domains
directly, so this wrapper only delegates every command, including the
``adopt``, ``rules`` and ``source`` namespaces, to the one compatibility parser
so ``--help`` advertises all of them.
"""

from __future__ import annotations

import sys
from pathlib import Path

_SCRIPT_DIR = Path(__file__).resolve().parent
if str(_SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(_SCRIPT_DIR))

from knowmade_control import legacy_cli as _legacy
from knowmade_control.stdio import configure_utf8_stdio
from knowmade_control.legacy_cli import *  # noqa: F401,F403 - compatibility re-export


def main(argv: list[str] | None = None) -> int:
    configure_utf8_stdio()
    values = list(sys.argv[1:] if argv is None else argv)
    return int(_legacy.main(values))


if __name__ == "__main__":
    sys.exit(main())
