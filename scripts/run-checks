#!/usr/bin/env bash
# Local replacement for the GitHub Actions lane.
#
# The repository's checks run here rather than on GitHub. This script is the
# single definition of that lane: the same steps, in the same order, with the
# same names the workflow used, so a local run and a former CI run are
# comparable line for line.
#
# Usage:
#   scripts/run-checks              # run every step, report a summary
#   scripts/run-checks --fast       # omit the steps that need an external runtime (see FAST_SKIP)
#   scripts/run-checks --list       # print the step list and exit
#   scripts/run-checks --step NAME  # run one step by name (repeatable)
#   KNOWMADE_STRICT=1 scripts/run-checks   # a step that reports SKIP counts as a failure
#
# A step that cannot run its real checks on this machine prints a line
# `SKIP: <reason>` and exits 0; it is reported as SKIP, never as PASS.
# Exit status is 0 only when every executed step passed (or, without
# KNOWMADE_STRICT=1, skipped with a reason).
set -uo pipefail

# A hook or `git rebase --exec` exports these; a step's own git calls must
# answer for the step's cwd, not for the invoking repository (#131, #135).
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX GIT_OBJECT_DIRECTORY

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

# name<TAB>command. Order matters: cheap structural checks first, so an obvious
# breakage is reported in seconds rather than minutes.
#
# The steps down to "Query-lite generated profile sync" are the lane the GitHub
# workflow used to run, under its own step names so old and new runs stay
# comparable. Everything after that is what the workflow never covered: the
# static token gate and the remaining suites CLAUDE.md marks as always-run.
STEPS=$(
  cat <<'LIST'
Documentation consistency	./tests/test-docs-consistency.sh
Executable modes of the local lane	./tests/test-executable-modes.sh
Check runner self-test	./tests/test-run-checks.sh
Plugin/package validation	./tests/test-plugin-validate.sh
Repository boundary (code is not data)	./tests/test-repo-boundary.sh
Engine contract and wiki identity	./tests/test-identity-contract.sh
Engine manifest lookup per packaging	./tests/test-engine-packaging.sh
Corpus rule-set compatibility	./tests/test-rule-sets.sh
Shared root identity resolution	./tests/test-control-plane-roots.sh
Package entry points and schema domain	./tests/test-control-plane-schema.sh
Brownfield adoption behavior	./tests/test-local-cli-adopt.sh
Brownfield batch resume state machine	./tests/test-local-cli-adopt-batch.sh
Unified adoption compatibility surface	./tests/test-unified-adopt.sh
Deterministic package sync	./tests/test-control-plane-sync.sh
Codex adoption behavioral contract	./tests/test-codex-adoption-eval.sh
Structural fixtures	./tests/test-structure.sh
Lint rejects every defect fixture	./tests/test-lint-defects.sh
Migration fixtures upgrade losslessly	./tests/test-migration-fixtures.sh
CLI subcommand smoke	python3 ./tests/test_cli_subcommands.py
Main deterministic lint suite	./tests/test-local-cli-lint.sh
Whole-tree link checks and lint --all	./tests/test-local-cli-links.sh
Federation registry and locate	./tests/test-local-cli-registry.sh
Cross-root references	./tests/test-local-cli-refs.sh
Hub inbox dispatch	./tests/test-local-cli-inbox.sh
Lint fix classes and preflight	./tests/test-local-cli-lint-fix.sh
Lint CI annotations, profiles, dataset verify	./tests/test-local-cli-lint-ci.sh
Index check/rebuild and log append	./tests/test-local-cli-index-log.sh
Wiki init scaffold	./tests/test-local-cli-init.sh
Status overview	./tests/test-local-cli-status.sh
Project list, new and add	./tests/test-local-cli-project.sh
Source original lifecycle	./tests/test-source-lifecycle.sh
Codex generated mirror sync	./tests/test-codex-sync.sh
OpenCode generated mirror sync	./tests/test-opencode-sync.sh
Query-lite generated profile sync	./tests/test-query-lite-sync.sh
Static token-efficiency gate	./scripts/benchmark-token-efficiency static --check
Retract and privacy-log removal	./tests/test-local-cli-retract.sh
Private adapter registry and boundary	./tests/test-local-cli-adapters.sh
Personal specialist library	./tests/test-local-cli-specialists.sh
Project checkpoint privacy seal	./tests/test-local-cli-checkpoint.sh
Privacy scan	./tests/test-local-cli-privacy.sh
Session capture	./tests/test-session-capture.sh
Session concurrency	./tests/test-session-concurrency.sh
Token benchmark harness	./tests/test-token-benchmarks.sh
Codex runtime smoke test	./tests/test-codex-runtime.sh
LIST
)

# Steps omitted by --fast: only the ones that exercise an external runtime
# (a Codex binary or app-server). Every suite CLAUDE.md lists under "always
# run" stays in a --fast pass.
FAST_SKIP="Codex adoption behavioral contract
Codex runtime smoke test"

selected=""
fast=0
strict="${KNOWMADE_STRICT:-0}"
while [ $# -gt 0 ]; do
  case "$1" in
    --list)
      printf '%s\n' "$STEPS" | cut -f1
      exit 0
      ;;
    --fast) fast=1 ;;
    --step)
      shift
      [ $# -gt 0 ] || { echo "--step needs a name" >&2; exit 2; }
      selected="$selected$1
"
      ;;
    --steps-file)
      # Replace the built-in list; tests/test-run-checks.sh drives the runner
      # with fake steps through this.
      shift
      [ $# -gt 0 ] && [ -f "$1" ] || { echo "--steps-file needs a readable file" >&2; exit 2; }
      STEPS="$(cat "$1")"
      ;;
    -h|--help)
      sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      exit 2
      ;;
  esac
  shift
done

# A mistyped --step name must not look like a clean run.
if [ -n "$selected" ]; then
  while IFS= read -r want; do
    [ -n "$want" ] || continue
    if ! printf '%s\n' "$STEPS" | cut -f1 | grep -Fxq "$want"; then
      echo "no such step: $want" >&2
      echo "run --list to see the step names" >&2
      exit 2
    fi
  done <<<"$selected"
fi

started="$(date +%s)"
passed=0
failed=0
skipped=0
failed_names=""
skipped_names=""

while IFS=$'\t' read -r name command; do
  [ -n "${name:-}" ] || continue

  if [ -n "$selected" ] && ! grep -Fxq "$name" <<<"$selected"; then
    continue
  fi
  if [ "$fast" -eq 1 ] && [ -z "$selected" ] && grep -Fxq "$name" <<<"$FAST_SKIP"; then
    printf 'SKIP  %-42s     omitted by --fast\n' "$name"
    skipped=$((skipped + 1))
    skipped_names="$skipped_names  $name: omitted by --fast
"
    continue
  fi

  # The step list is this loop's stdin; a step must never read it, or it would
  # swallow the remaining lines and end the run early with nothing failed.
  step_started="$(date +%s)"
  output="$(eval "$command" 2>&1 </dev/null)"
  status=$?
  elapsed="$(($(date +%s) - step_started))"

  if [ "$status" -eq 0 ] && reason="$(printf '%s\n' "$output" | grep -m1 '^SKIP:')"; then
    reason="${reason#SKIP:}"
    reason="${reason# }"
    if [ "$strict" = "1" ]; then
      printf 'FAIL  %-42s %ss\n' "$name" "$elapsed"
      printf '      skipped with KNOWMADE_STRICT=1: %s\n' "$reason"
      failed=$((failed + 1))
      failed_names="$failed_names  $name (skipped: $reason)
"
    else
      printf 'SKIP  %-42s %ss  %s\n' "$name" "$elapsed" "$reason"
      skipped=$((skipped + 1))
      skipped_names="$skipped_names  $name: $reason
"
    fi
  elif [ "$status" -eq 0 ]; then
    printf 'PASS  %-42s %ss\n' "$name" "$elapsed"
    passed=$((passed + 1))
  else
    printf 'FAIL  %-42s %ss\n' "$name" "$elapsed"
    printf '%s\n' "$output" | tail -25 | sed 's/^/      /'
    failed=$((failed + 1))
    failed_names="$failed_names  $name
"
  fi
done <<<"$STEPS"

echo
printf 'checks: %d passed, %d failed, %d skipped in %ss\n' \
  "$passed" "$failed" "$skipped" "$(($(date +%s) - started))"

if [ "$skipped" -gt 0 ]; then
  echo "skipped steps:"
  printf '%s' "$skipped_names"
fi

if [ "$failed" -gt 0 ]; then
  echo "failed steps:"
  printf '%s' "$failed_names"
  exit 1
fi

if [ "$selected" != "" ] || [ "$fast" -eq 1 ]; then
  echo "note: this was a partial run; the push gate runs every step."
fi
exit 0
