#!/usr/bin/env python3
"""Public deterministic Knowmade CLI.

A thin launcher: it puts its own directory on ``sys.path`` so the
``knowmade_control`` package beside it is the one imported (a source checkout's
``scripts/`` or a packaged ``bin/``), then runs ``knowmade_control.cli``, whose
``NAMESPACES`` list registers every namespace on the one parser so ``--help``
advertises all of them. The star import keeps the compatibility names of
``knowmade_control.legacy_cli`` in this module's namespace for runpy callers.
"""

from __future__ import annotations

import sys
from pathlib import Path

_SCRIPT_DIR = Path(__file__).resolve().parent
if str(_SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(_SCRIPT_DIR))

from knowmade_control import cli as _cli
from knowmade_control.legacy_cli import *  # noqa: F401,F403 - compatibility re-export


def main(argv: list[str] | None = None) -> int:
    values = list(sys.argv[1:] if argv is None else argv)
    return int(_cli.main(values))


if __name__ == "__main__":
    sys.exit(main())
